rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Reserved email for the one-time ADMIN bootstrap (see AppContext.tsx).
    // Must match emailForName(VITE_ADMIN_BOOTSTRAP_NAME). If you bootstrap
    // with a different admin name, update this constant to match.
    function isReservedAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'ADMINISTRADOR@rapidbodegon.local';
    }

    // --- users ---
    match /users/{userId} {
      allow read: if isSignedIn();

      // Self-registration: a signed-in user may create only their own
      // profile, as a CLIENT with a zero starting balance. Creating an
      // ADMIN profile is only allowed for the reserved bootstrap email,
      // so a regular client cannot self-elevate to ADMIN.
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.balanceUSD == 0
        && request.resource.data.keys().hasOnly(['id', 'name', 'role', 'balanceUSD'])
        && (
          request.resource.data.role == 'CLIENT'
          || (request.resource.data.role == 'ADMIN' && isReservedAdminEmail())
        );

      // Admins can update any profile (approve payments, load consumption,
      // change balances). Clients may only edit their own display name —
      // balanceUSD can never be touched by a client write.
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));

      allow delete: if isAdmin();
    }

    // --- products ---
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- transactions ---
    match /transactions/{txId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

      // Admin can log any transaction (e.g. CONSUMPTION for a client).
      // A client may only create their own PENDING payment report — they
      // can never mark their own payment as COMPLETED.
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.type == 'PAYMENT'
            && request.resource.data.status == 'PENDING');

      // Only admins change status (approve/reject) or edit a transaction.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- config ---
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Deny everything else by default (no more `allow read, write: if true`).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

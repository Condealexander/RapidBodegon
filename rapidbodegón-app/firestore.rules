rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // --- users ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Self-registration: a signed-in user may create only their own
      // profile, and only as CLIENT with a zero starting balance. ADMIN
      // accounts are never created through this app's client code at all —
      // they're created by scripts/create-admin.mjs using the Firebase
      // Admin SDK, which bypasses these rules entirely.
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.role == 'CLIENT'
        && request.resource.data.balanceUSD == 0
        && request.resource.data.keys().hasOnly(['id', 'name', 'role', 'balanceUSD']);

      // Admins can update any profile. Clients may only edit their own
      // display name — balanceUSD can never be touched by a client write.
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));

      allow delete: if isAdmin();
    }

    // --- products ---
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- transactions ---
    match /transactions/{txId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

      // Keep existing client reporting online until the callable backend is deployed.
      allow create: if isAdmin() || (isOwner(request.resource.data.userId)
        && request.resource.data.id == txId
        && request.resource.data.status == 'PENDING'
        && request.resource.data.date is string
        && (
          (request.resource.data.type == 'PAYMENT'
            && request.resource.data.keys().hasOnly([
              'id', 'userId', 'type', 'amountUSD', 'date', 'status', 'reference'
            ])
            && request.resource.data.amountUSD is number
            && request.resource.data.amountUSD > 0
            && request.resource.data.reference is string
            && request.resource.data.reference.matches('^[0-9]{4,12}$'))
          ||
          (request.resource.data.type == 'CONSUMPTION'
            && request.resource.data.keys().hasOnly([
              'id', 'userId', 'type', 'amountUSD', 'date', 'status', 'productId', 'quantity'
            ])
            && request.resource.data.amountUSD is number
            && request.resource.data.amountUSD >= 0
            && request.resource.data.productId is string
            && request.resource.data.quantity is int
            && request.resource.data.quantity > 0
            && request.resource.data.quantity <= 50)
        ));

      allow update: if isAdmin()
        && (
          resource.data.type != 'PAYMENT'
          || resource.data.status != 'PENDING'
          || request.resource.data.status != 'COMPLETED'
          || (
            request.resource.data.amountUSD == resource.data.amountUSD
            && get(/databases/$(database)/documents/financials/global).data.initialized == true
            && getAfter(/databases/$(database)/documents/financials/global).data.totalCollectedUSD
              == get(/databases/$(database)/documents/financials/global).data.totalCollectedUSD
                + resource.data.amountUSD
          )
        );
      allow delete: if isAdmin();
    }

    // --- config ---
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

        // --- cycles (cierres de ciclo de cobro: cortes 3, 10, 17 y 25) ---
    match /cycles/{cycleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- expenses (registro financiero administrativo, sin cambios de stock) ---
    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id', 'description', 'amountUSD', 'date', 'createdBy'
        ])
        && request.resource.data.id == expenseId
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 160
        && request.resource.data.amountUSD is number
        && request.resource.data.amountUSD > 0
        && request.resource.data.date is string
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/financials/global).data.initialized == true
        && getAfter(/databases/$(database)/documents/financials/global).data.totalExpensesUSD
          == get(/databases/$(database)/documents/financials/global).data.totalExpensesUSD
            + request.resource.data.amountUSD;
      allow update, delete: if false;
    }

    // The aggregate is initialized only by the Admin SDK migration script.
    // Admin client transactions may only increase the appropriate totals.
    match /financials/{financialId} {
      allow read: if isAdmin() && financialId == 'global';
      allow create, delete: if false;
      allow update: if isAdmin()
        && financialId == 'global'
        && resource.data.initialized == true
        && request.resource.data.initialized == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'totalCollectedUSD', 'totalExpensesUSD', 'updatedAt'
        ])
        && request.resource.data.totalCollectedUSD is number
        && request.resource.data.totalCollectedUSD >= resource.data.totalCollectedUSD
        && request.resource.data.totalExpensesUSD is number
        && request.resource.data.totalExpensesUSD >= resource.data.totalExpensesUSD
        && request.resource.data.updatedAt is string;
    }

    // Deny everything else by default (no more `allow read, write: if true`).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}